diff --git a/api/src/api/bitcoin.rs b/api/src/api/bitcoin.rs
index 821f280..d89a484 100644
--- a/api/src/api/bitcoin.rs
+++ b/api/src/api/bitcoin.rs
@@ -30,3 +30,71 @@ pub struct ApplyPassphrase {
     #[n(0)]
     pub fingerprint: Option<String>,
 }
+
+// Coinjoin remote signing (WabiSabi). One on-device policy approval opens a
+// session; conforming rounds then get SLIP-0019 ownership proofs and PSBT
+// signatures (the latter via the existing SignPsbt) without further prompts.
+// Non-conforming requests are rejected, never escalated to the user.
+
+/// Ask the device to authorize a coinjoin session. The device shows the policy
+/// on the trusted display; the user approves or denies there.
+#[quantum_link]
+pub struct AuthorizeCoinjoinRequest {
+    #[n(0)]
+    pub account_id: String,
+    /// Coordinator identifier; ownership proofs are bound to it (proofs are
+    /// only produced for commitment data opening with this identifier).
+    #[n(1)]
+    pub coordinator_id: String,
+    /// Maximum sats the wallet may lose per round (mining fee share +
+    /// coordination fee): sum(our inputs) - sum(our outputs), per round.
+    #[n(2)]
+    pub max_fee_contribution_sats: u64,
+    /// Round budget: the session stops signing after this many rounds.
+    #[n(3)]
+    pub max_rounds: u16,
+    /// Session lifetime in seconds from approval.
+    #[n(4)]
+    pub valid_for_seconds: u32,
+}
+
+#[quantum_link]
+pub struct AuthorizeCoinjoinResponse {
+    #[n(0)]
+    pub account_id: String,
+    /// The authorized session id, or None if the user denied the policy.
+    /// Sessions are RAM-only on the device and end at max_rounds, expiry,
+    /// reboot, or an explicit denial of a later request.
+    #[n(1)]
+    pub session_id: Option<u32>,
+}
+
+/// Request a SLIP-0019 ownership proof for one input under an authorized
+/// session. This is a BIP-322-style proof over the coordinator's commitment
+/// data — not a PSBT signature, which is why SignPsbt cannot express it.
+#[quantum_link]
+pub struct GetOwnershipProofRequest {
+    #[n(0)]
+    pub account_id: String,
+    #[n(1)]
+    pub session_id: u32,
+    /// BIP-32 derivation path of the input's key (hardened = high bit set).
+    #[n(2)]
+    pub derivation_path: Vec<u32>,
+    /// The coordinator's commitment data; must open with the session's
+    /// authorized coordinator_id or the device refuses.
+    #[n(3)]
+    pub commitment_data: Vec<u8>,
+}
+
+#[quantum_link]
+pub struct GetOwnershipProofResponse {
+    #[n(0)]
+    pub account_id: String,
+    #[n(1)]
+    pub session_id: u32,
+    /// The serialized SLIP-0019 proof, or None if the request was outside the
+    /// session policy (wrong coordinator, path out of scope, session expired).
+    #[n(2)]
+    pub proof: Option<Vec<u8>>,
+}
diff --git a/api/src/api/message.rs b/api/src/api/message.rs
index 613dd5a..8b01b90 100644
--- a/api/src/api/message.rs
+++ b/api/src/api/message.rs
@@ -132,4 +132,13 @@ pub enum QuantumLinkMessage {
     UnpairingRequest(UnpairingRequest),
     #[n(36)]
     UnpairingResponse(UnpairingResponse),
+
+    #[n(37)]
+    AuthorizeCoinjoinRequest(AuthorizeCoinjoinRequest),
+    #[n(38)]
+    AuthorizeCoinjoinResponse(AuthorizeCoinjoinResponse),
+    #[n(39)]
+    GetOwnershipProofRequest(GetOwnershipProofRequest),
+    #[n(40)]
+    GetOwnershipProofResponse(GetOwnershipProofResponse),
 }
diff --git a/api/tests/golden_tests.rs b/api/tests/golden_tests.rs
index e5eefa3..1a754c0 100644
--- a/api/tests/golden_tests.rs
+++ b/api/tests/golden_tests.rs
@@ -545,3 +545,59 @@ fn golden_restore_magic_backup_result_error() {
 fn golden_heartbeat() {
     assert_golden!(QuantumLinkMessage::Heartbeat(Heartbeat {}))
 }
+
+#[test]
+fn golden_authorize_coinjoin_request() {
+    assert_golden!(QuantumLinkMessage::AuthorizeCoinjoinRequest(
+        AuthorizeCoinjoinRequest {
+            account_id: "account-1".to_string(),
+            coordinator_id: "coinjoin.nl".to_string(),
+            max_fee_contribution_sats: 1000,
+            max_rounds: 10,
+            valid_for_seconds: 43200,
+        },
+    ));
+}
+
+#[test]
+fn golden_authorize_coinjoin_response_approved() {
+    assert_golden!(QuantumLinkMessage::AuthorizeCoinjoinResponse(
+        AuthorizeCoinjoinResponse {
+            account_id: "account-1".to_string(),
+            session_id: Some(1),
+        },
+    ));
+}
+
+#[test]
+fn golden_authorize_coinjoin_response_denied() {
+    assert_golden!(QuantumLinkMessage::AuthorizeCoinjoinResponse(
+        AuthorizeCoinjoinResponse {
+            account_id: "account-1".to_string(),
+            session_id: None,
+        },
+    ));
+}
+
+#[test]
+fn golden_get_ownership_proof_request() {
+    assert_golden!(QuantumLinkMessage::GetOwnershipProofRequest(
+        GetOwnershipProofRequest {
+            account_id: "account-1".to_string(),
+            session_id: 1,
+            derivation_path: vec![0x80000054, 0x80000000, 0x80000000, 1, 0],
+            commitment_data: vec![0x0b, 0x63, 0x6f, 0x69, 0x6e, 0x6a, 0x6f, 0x69, 0x6e, 0x2e, 0x6e, 0x6c],
+        },
+    ));
+}
+
+#[test]
+fn golden_get_ownership_proof_response() {
+    assert_golden!(QuantumLinkMessage::GetOwnershipProofResponse(
+        GetOwnershipProofResponse {
+            account_id: "account-1".to_string(),
+            session_id: 1,
+            proof: Some(vec![0x53, 0x4c, 0x00, 0x19]),
+        },
+    ));
+}
